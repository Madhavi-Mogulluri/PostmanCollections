		{
			"name": "parse html using cheerio Api",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let cheerio = require('cheerio')",
							"pm.test('check html has titile', function(){",
							"    pm.expect(pm.response.text()).to.include('The Internet');",
							"",
							"})",
							"",
							"pm.test('check it has header as Login Page',function() {",
							"    pm.expect(pm.response.text()).to.include('Login Page')",
							"})",
							"",
							"pm.test('check it has login form',function () {",
							"    let res = cheerio.load(pm.response.text())",
							"    let loginform = res('[name=\"login\"]')",
							"    console.log('login form is' + loginform);",
							"",
							"    let attrvalue = loginform.attr('id')",
							"    console.log('value is ' + attrvalue);",
							"",
							"     pm.expect(loginform.find('#username').length).to.be.eql(1);",
							"    pm.expect(loginform.find('#password').length).to.be.eql(1);",
							"",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
