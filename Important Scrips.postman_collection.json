		{
			"name": "read Data from complex json",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let res = pm.response.json().json;",
							"console.log(res)",
							"",
							"let filtersData = [];",
							"res.forEach(company => {",
							"  company.filters.forEach(e => {",
							"      filtersData.push(e)",
							"  })",
							"})",
							"console.log(filtersData)",
							"let manfacurerData = filtersData.filter(e => e.name === 'MANUFACTURER');",
							"console.log(manfacurerData);",
							"",
							"pm.test(\"Check MANUFACTURER \", function () {",
							"    manfacurerData.forEach(e => {",
							"    pm.expect(e.id).to.eql(103);",
							"    pm.expect(e.isAllowed).to.be.false;",
							"    pm.expect(e.name).to.eql('MANUFACTURER');",
							"    })",
							"    ",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
