		{
			"name": "2-updateAllUsers",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let usersid = pm.variables.get('userIDs');",
							"",
							"console.log(usersid);",
							"if (Array.isArray(usersid) && usersid.length > 0) {",
							"    pm.variables.set('singleUserID', usersid.shift())",
							"    console.log(usersid.length)",
							"    pm.execution.setNextRequest('2-updateAllUsers')",
							"}",
							"else{",
							"    console.log('all users are updated')",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer 5bae82255d8dd3e8bb494800c89517bf992e712eb996533c5e5eebea98d2caf2",
