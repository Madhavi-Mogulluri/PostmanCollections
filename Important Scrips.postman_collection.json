		{
			"name": "Fetch response and send a new request",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let res = pm.response.json();",
							"let urlData = res.json.urls;",
							"console.log(urlData);",
							"",
							"Object.keys(urlData).forEach(ele => {",
							"    pm.test('send url', function(){",
							"        pm.sendRequest({",
							"            'url' : urlData[ele],",
							"            'method' : 'GET'",
							"        },function(error,response){",
							"            if(error){",
							"                console.log(error)",
							"            }",
							"            else{",
							"                console.log(response.code)",
							"                pm.response.to.have.status(200);",
							"            }",
							"        })",
							"    })",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
