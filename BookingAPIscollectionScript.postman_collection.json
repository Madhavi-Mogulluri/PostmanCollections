	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"if(pm.info.requestName ==='UpdateBooking'){",
					"    pm.sendRequest({",
					"        method:\"POST\",",
					"        url : pm.environment.get('baseURL')+'/auth',",
					"        header: {",
					"            'Content-type': 'application/json'",
					"        },",
					"        body :{",
					"            mode :'raw',",
					"            raw :JSON.stringify({",
					"            username : pm.environment.get('username'),",
					"            password : pm.environment.get('password')",
					"",
					"        })",
					"        }",
					"",
					"    }, (error,response) => {",
					"    if(error){",
					"        console.log(error)",
					"    }",
					"    else{",
					"       let responsebody =  JSON.parse(response.text())",
					"       let tokenID = responsebody.token;",
					"       console.log(tokenID);",
					"       pm.variables.set('new_token_id',tokenID)",
					"    }",
					"})",
					"}"
				]
			}
		},
