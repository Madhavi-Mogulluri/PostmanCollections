		{
			"name": "get data from json array and assert",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let res = pm.response.json();",
							"let region = res.json.regionId;",
							"console.log(region)",
							"let filtersData = res.json.filters;",
							"console.log('filtersdata is :', filtersData)  ",
							"let vendorData = filtersData.find(e => e.name === 'VENDOR') ",
							"console.log('vendordata is :', vendorData);",
							"",
							"// find methods gives the 1st element that matches, stops  searchng after find",
							"// filter gives all the elements that matches",
							"",
							"pm.test('check vendor data', function (){",
							"",
							"    pm.expect(vendorData.isAllowed).to.be.false",
							"",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
