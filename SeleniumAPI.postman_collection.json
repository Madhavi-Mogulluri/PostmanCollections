	"item": [
		{
			"name": "1-Launch Browser",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let response = pm.response.json();",
							"let sessionID = response.value.sessionId;",
							"",
							"pm.variables.set(\"SID\",sessionID);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json;charset=utf-8",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"capabilities\": {\n        \"alwaysMatch\": {\n            \"browserName\": \"chrome\"\n        }\n    }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseURL}}/session",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"session"
					]
				}
			},
			"response": []
		},
		{
			"name": "2-Enter URL",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let appURL = \"https://www.google.com\"",
							"",
							"pm.variables.set(\"APPURL\",appURL);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json;charset=utf-8",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"url\": \"{{APPURL}}\"\n}"
				},
				"url": {
					"raw": "{{baseURL}}/session/{{SID}}/url",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"session",
						"{{SID}}",
						"url"
					]
				}
			},
			"response": []
		},
		{
			"name": "3-Find an element",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"",
							"let response = pm.response.json();",
							"let value = response.value;",
							"let elementID = value[\"element-6066-11e4-a52e-4f735466cecf\"];",
							"pm.variables.set('ELEMENTID',elementID);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json;charset=utf-8",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"using\": \"xpath\",\n    \"value\": \"//textarea[@name='q']\"\n}"
				},
				"url": {
					"raw": "http://localhost:4444/session/{{SID}}/element",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "4444",
					"path": [
						"session",
						"{{SID}}",
						"element"
					]
				}
			},
			"response": []
